#include <stdio.h>

int main() {
	
	int arr[]={20,30,15,12,47};
	int *aparr=arr;
	
	printf("primer elemento: %d\n", *aparr);
	printf("segundo elemento: %d\n", *(aparr + 1));
	printf("tercer elemento: %d\n", *(aparr + 2));
	printf("cuarto elemento: %d\n", *(aparr + 3));
	printf("quinto elemento: %d\n", *(aparr + 4));
	
	
	return 0;
}
